# MongoDB Atlas (same URI across clients; different DB name per client)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=demo_local_business

# Admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SESSION_SECRET=change-me-long-random-string

# Profile details gate (separate from admin)
PROFILE_GATE_USERNAME=dhamodharan
PROFILE_GATE_PASSWORD=dhamodharan123
PROFILE_GATE_SESSION_SECRET=change-me-profile-gate-secret

# Vercel Blob (production image uploads)
# On Vercel, connect a public Blob store — OIDC vars are added automatically:
#   BLOB_STORE_ID (or BLOB_READ_WRITE_TOKEN_STORE_ID with a custom prefix)
#   VERCEL_OIDC_TOKEN (runtime only)
# Optional fallback for non-Vercel hosts or local testing against Blob:
#   BLOB_READ_WRITE_TOKEN
# Local `npm run dev` without Blob vars saves files under public/uploads/

# Public site URL (sitemap / robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: log/notify destination for new enquiries (hook in src/lib/mail.ts)
NOTIFY_EMAIL_TO=
