# MongoDB Atlas (same URI across clients; different DB name per client)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=demo_local_business

# Admin session signing
ADMIN_SESSION_SECRET=change-me-long-random-string

# Admin login credentials (optional override).
# If both are set, they take precedence over PROFILE_GATE_* below.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Admin login (default credentials — also used when ADMIN_USERNAME/PASSWORD unset)
PROFILE_GATE_USERNAME=dhamodharan
PROFILE_GATE_PASSWORD=dhamodharan123
PROFILE_GATE_SESSION_SECRET=change-me-profile-gate-secret

# Cloudinary (image / video uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public site URL (sitemap / robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: log/notify destination for new enquiries (hook in src/lib/mail.ts)
NOTIFY_EMAIL_TO=
