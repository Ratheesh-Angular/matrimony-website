# MongoDB Atlas (same URI across clients; different DB name per client)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=demo_local_business

# Admin session signing
ADMIN_SESSION_SECRET=change-me-long-random-string

# Member (phone + password) session signing
MEMBER_SESSION_SECRET=change-me-member-session-secret

# Lifetime premium unlock (paise). Default 26000 = ₹260
PREMIUM_AMOUNT_PAISE=26000

# Admin login credentials (optional override).
# If both are set, they take precedence over PROFILE_GATE_* below.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Admin login (default credentials — also used when ADMIN_USERNAME/PASSWORD unset)
PROFILE_GATE_USERNAME=dhamodharan
PROFILE_GATE_PASSWORD=dhamodharan123
PROFILE_GATE_SESSION_SECRET=change-me-profile-gate-secret

# Cloudflare R2 (image / video uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=matrimony-media
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=

# Public site URL (sitemap / robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: log/notify destination for new enquiries (hook in src/lib/mail.ts)
NOTIFY_EMAIL_TO=

# Razorpay (one-time orders + subscriptions)
# Dashboard → API Keys. Use test keys locally; set the same as Cloudflare secrets for deploy.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same as RAZORPAY_KEY_ID — exposed to Checkout.js on the client
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Dashboard → Webhooks → create endpoint POST /api/webhooks/razorpay
# Subscribe: payment.captured, payment.failed, subscription.authenticated,
# subscription.activated, subscription.charged, subscription.pending,
# subscription.halted, subscription.cancelled, subscription.completed
RAZORPAY_WEBHOOK_SECRET=
